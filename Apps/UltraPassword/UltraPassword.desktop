[Desktop Entry]
# The freedesktop shortcut for UltraPassword. `Icon=UltraPassword` is resolved
# through the icon themes; the install rules put media/appicon/UltraPassword.png
# and .svg into share/icons/hicolor so the lookup lands on them.
#
# No MimeType= and no argument on Exec: a vault is opened from inside the app,
# behind its master-password prompt.
Type=Application
Version=1.5
Name=UltraPassword
GenericName=Password Manager
Comment=Keep your passwords in an encrypted vault, organised in groups
Exec=UltraPassword
TryExec=UltraPassword
Icon=UltraPassword
Terminal=false
StartupNotify=true
StartupWMClass=UltraPassword
Categories=Utility;Security;
Keywords=password;vault;passkey;manager;login;security;keychain;
