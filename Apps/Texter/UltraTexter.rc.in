// Apps/Texter/UltraTexter.rc.in
// Windows Resource Script for UltraTexter.
// Embeds: version information, application manifest.
//
// Template: CMake writes UltraTexter.rc into the build tree from this file,
// filling the version in from the first line of Docs/Texter/CHANGELOG.md.
// Edit this file, never the generated one.

#include <windows.h>

// ===== APPLICATION MANIFEST =====
// Embeds UltraTexter.manifest directly into the EXE
// ID 1 = application manifest (required by Windows)
1 RT_MANIFEST "UltraTexter.manifest"

// ===== VERSION INFORMATION =====
VS_VERSION_INFO VERSIONINFO
    FILEVERSION     @UCRES_VERSION_COMMA4@
    PRODUCTVERSION  @UCRES_VERSION_COMMA4@
    FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
    FILEFLAGS       VS_FF_DEBUG
#else
    FILEFLAGS       0
#endif
    FILEOS          VOS_NT_WINDOWS32
    FILETYPE        VFT_APP
    FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // Language: English (US), Code page: Unicode
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Cloverleaf UG\0"
            VALUE "FileDescription",  "UltraCanvasTexter - Cross-Platform Text Editor\0"
            VALUE "FileVersion",      "@UCRES_VERSION@\0"
            VALUE "InternalName",     "UltraCanvasTexter\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Cloverleaf UG\0"
            VALUE "OriginalFilename", "UltraCanvasTexter.exe\0"
            VALUE "ProductName",      "UltraCanvasTexter\0"
            VALUE "ProductVersion",   "@UCRES_VERSION@\0"
            VALUE "Comments",         "Part of the ULTRA OS ecosystem - ultracanvas.dev\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        // English (US), Unicode
        VALUE "Translation", 0x0409, 0x04B0
    END
END
