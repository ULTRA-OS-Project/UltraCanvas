// Apps/UltraMail/engine/UltraMailOAuthDefaults.h.in
// GENERATED at configure time into the build tree as UltraMailOAuthDefaults.h.
// Do NOT edit the generated copy and do NOT commit it (it lives under the build
// tree). Edit this .in template instead.
//
// The OAuth sign-in service this build signs in through, baked in as the
// lowest-priority source (OAuthApps::SetServiceUrl(), the environment and
// oauth.ini all override it - see OAuthApps::ServiceUrl). No client id and no
// secret live in the application any more: the service holds them
// (Server/OAuthCallback). Empty in a build configured with
// -DULTRAMAIL_OAUTH_SERVICE_URL="", which then signs in only with a client
// configured at run time.
#pragma once

namespace UltraMail {
namespace defaults {

inline constexpr const char* kOAuthServiceUrl = @UM_OAUTH_SERVICE_URL_C@;

} // namespace defaults
} // namespace UltraMail
