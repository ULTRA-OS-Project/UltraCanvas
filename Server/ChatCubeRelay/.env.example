# Copy to .env (or /etc/chatcube-relay.env for the systemd unit).
CHATCUBE_RELAY_DB=/var/lib/chatcube-relay/relay.sqlite3
CHATCUBE_RELAY_HOST=127.0.0.1
CHATCUBE_RELAY_PORT=8790
# Session lifetime in seconds (default 30 days).
CHATCUBE_RELAY_TOKEN_TTL=2592000
# ICE servers handed to the clients. TURN credentials are minted per user
# with coturn's use-auth-secret scheme: put the same value in coturn's
# static-auth-secret.
CHATCUBE_RELAY_STUN_URLS=stun:turn.example.org:3478
CHATCUBE_RELAY_TURN_URLS=turn:turn.example.org:3478?transport=udp,turns:turn.example.org:5349
CHATCUBE_RELAY_TURN_SECRET=change-me
# The Telegram application ChatCube signs in to Telegram as (my.telegram.org,
# "API development tools"). Signed-in clients fetch them from
# GET /v1/telegram-credentials, so changing them here needs no new ChatCube.
# Leave empty and the user types them into ChatCube.
CHATCUBE_RELAY_TELEGRAM_API_ID=
CHATCUBE_RELAY_TELEGRAM_API_HASH=
