# /etc/ultrastore-pay.env - the payment service's settings. Readable by root
# and the service's user only (chmod 640).
# The database: MySQL (pip install 'ultrastore-pay[mysql]') or PostgreSQL ('[postgres]')
# in production; sqlite:///path is for tests and development only.
ULTRASTORE_PAY_DB=mysql://ultrastore_pay:password@127.0.0.1:3306/ultrastore_pay
# ULTRASTORE_PAY_DB=postgresql://ultrastore_pay:password@127.0.0.1:5432/ultrastore_pay
ULTRASTORE_PAY_HOST=127.0.0.1
ULTRASTORE_PAY_PORT=8791
# Where the service is reached from the internet (Skrill posts the status report here).
ULTRASTORE_PAYMENT_BASE_URL=https://store.example
ULTRASTORE_PAYMENT_ENV=sandbox
# Skrill Quick Checkout (the merchant portal: Settings, Developer settings).
ULTRASTORE_SKRILL_PAY_TO_EMAIL=
ULTRASTORE_SKRILL_SECRET_WORD=
ULTRASTORE_SKRILL_MERCHANT_ID=
# The API / MQI password: refunds and the end of a subscription's recurring payment.
ULTRASTORE_SKRILL_API_PASSWORD=
# ULTRASTORE_SKRILL_API_URL=https://www.skrill.com/app
# A subscription's licence stays valid this many days past the paid period (Skrill's retries).
ULTRASTORE_PAY_GRACE_DAYS=7
# The signed catalog the service prices from, and the keys it trusts (hex, comma-separated).
ULTRASTORE_PAY_CATALOG_URL=https://store.example/v1
ULTRASTORE_PAY_CATALOG_KEYS=
# The licence key (32-byte seed, hex); empty: made on the first start and kept in the database.
ULTRASTORE_PAY_LICENCE_SEED=
# The admin backend's token for GET /v1/sales.
ULTRASTORE_PAY_ADMIN_TOKEN=
# Signed URLs for restricted/ (nginx secure_link_md5).
ULTRASTORE_PAY_RESTRICTED_SECRET=
ULTRASTORE_PAY_RESTRICTED_BASE=https://store.example/v1
ULTRASTORE_PAY_RESTRICTED_TTL=600
