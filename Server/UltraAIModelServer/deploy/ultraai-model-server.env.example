# /etc/ultraai-model-server.env - owner root, mode 0600.
ULTRAAI_MODELS_DB=/var/lib/ultraai-models/models.sqlite3
ULTRAAI_MODELS_DATA=/var/lib/ultraai-models/data
ULTRAAI_MODELS_HOST=127.0.0.1
ULTRAAI_MODELS_PORT=8793
# Where clients reach the server; uploaded files are <base>/files/<sha256>/<name>.
ULTRAAI_MODELS_BASE_URL=https://models.example.org
# The super administrator's token: UltraAI ServerAdmin signs in with it.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ULTRAAI_MODELS_SUPER_TOKEN=
# The largest upload, in bytes (default 80 GiB).
#ULTRAAI_MODELS_MAX_UPLOAD=85899345920
# Fill an empty database with the framework's built-in gallery, catalogue and topics (default 1).
#ULTRAAI_MODELS_SEED=1
