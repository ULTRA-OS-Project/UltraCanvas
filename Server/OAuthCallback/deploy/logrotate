# logrotate rule for the sign-in service's nginx logs:
#
#   sudo cp deploy/logrotate /etc/logrotate.d/oauth-callback
#
# The privacy notice (Docs/Legal/Privacy/UltraMail.md, section 5.2) promises
# that the connection log is deleted after 14 days; this rule is what keeps
# that promise, whatever the distribution's default for nginx is. The
# providers' redirects never reach the log at all (deploy/nginx.conf).
/var/log/nginx/oauth-callback.access.log /var/log/nginx/oauth-callback.error.log {
    daily
    rotate 14
    maxage 14
    missingok
    notifempty
    compress
    delaycompress
    sharedscripts
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 "$(cat /var/run/nginx.pid)"
    endscript
}
