# The ULTRA OS OAuth sign-in service - copy to .env next to the service (or
# point OAUTH_CALLBACK_ENV_FILE at it) and fill in the registrations.
# A provider without a client id is not served. Never commit the real file.

# Where the providers send the browser: the redirect URI registered with each
# provider is <PUBLIC_URL>/callback/<provider>.
OAUTH_CALLBACK_PUBLIC_URL=https://oauth-callback.ultraos.eu

# Google Cloud console > APIs & Services > Credentials > OAuth client ID,
# application type "Web application", authorised redirect URI
# https://oauth-callback.ultraos.eu/callback/google
OAUTH_CALLBACK_GOOGLE_CLIENT_ID=
OAUTH_CALLBACK_GOOGLE_CLIENT_SECRET=

# Microsoft Entra > App registrations > Authentication > platform "Web",
# redirect URI https://oauth-callback.ultraos.eu/callback/microsoft. A
# "Web" platform needs a client secret (Certificates & secrets); leave the
# secret empty for a registration that keeps "Mobile and desktop" with
# "Allow public client flows" on.
OAUTH_CALLBACK_MICROSOFT_CLIENT_ID=
OAUTH_CALLBACK_MICROSOFT_CLIENT_SECRET=

# Yahoo developer console > app > Redirect URI(s)
# https://oauth-callback.ultraos.eu/callback/yahoo, API permission Mail.
# Yahoo's Client ID is the "Consumer Key", the secret the "Consumer Secret".
OAUTH_CALLBACK_YAHOO_CLIENT_ID=
OAUTH_CALLBACK_YAHOO_CLIENT_SECRET=

# Dropbox App Console > app > OAuth 2 > Redirect URIs
# https://oauth-callback.ultraos.eu/callback/dropbox, with the files, metadata
# and sharing permissions. App key / App secret. Serves UltraCloud's Dropbox
# links in UltraMail's composer; leave empty when nothing needs Dropbox.
OAUTH_CALLBACK_DROPBOX_CLIENT_ID=
OAUTH_CALLBACK_DROPBOX_CLIENT_SECRET=

# Optional tuning (the defaults are in oauth_callback/config.py).
#OAUTH_CALLBACK_SESSION_TTL=600        # seconds a sign-in may wait for the browser
#OAUTH_CALLBACK_RESULT_TTL=120         # seconds a code waits for the application
#OAUTH_CALLBACK_RATE_LIMIT=60          # requests per minute per address; 0 = off
#OAUTH_CALLBACK_TRUST_PROXY=1          # read X-Forwarded-For (nginx in front)
#OAUTH_CALLBACK_PROVIDER_TIMEOUT=20    # seconds per call to a provider
