# /etc/ultrastore-market.env - the marketplace service's settings. Readable by
# root and the service's user only (chmod 640).
# The database: MySQL in production (pip install 'ultrastore-market[mysql]'); PostgreSQL
# works too; sqlite:///path is for tests and development only.
ULTRASTORE_MARKET_DB=mysql://ultrastore_market:password@127.0.0.1:3306/ultrastore_market
ULTRASTORE_MARKET_HOST=127.0.0.1
ULTRASTORE_MARKET_PORT=8792
ULTRASTORE_MARKET_BASE_URL=https://store.example
# The operator's bearer token (the operator's window and command line).
ULTRASTORE_MARKET_OPERATOR_TOKEN=
# A merchant's signed request is good this many seconds around its timestamp.
ULTRASTORE_MARKET_REQUEST_WINDOW=300
# The publish (POST /v1/publish): where catalog.json and its signature go, the operator's
# signing seed (32 bytes, hex; empty: made on the first start and kept in the database), more
# keys for trusted_keys (comma-separated, a key being rotated in), the payment service the
# catalog names and its licence key.
ULTRASTORE_MARKET_PUBLISH_DIR=/var/www/ultrastore/v1
ULTRASTORE_MARKET_SIGNING_SEED=
ULTRASTORE_MARKET_TRUSTED_KEYS=
ULTRASTORE_MARKET_PAYMENT_URL=https://store.example
ULTRASTORE_MARKET_LICENCE_KEY=
