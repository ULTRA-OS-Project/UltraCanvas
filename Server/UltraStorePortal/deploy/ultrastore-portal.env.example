# /etc/ultrastore-portal.env - the portal's settings. Readable by root and the
# service's user only (chmod 640).

# The one root the store lives under: every URL the portal writes - the
# catalog's packages and pictures, the links in a mail - is this root plus a
# path. Leave it out and it is https://store.ultraos.eu.
ULTRASTORE_PORTAL_BASE_URL=https://store.ultraos.eu
# The account's own root: where people sign up and sign in, and the issuer
# other services sign in through (OpenID Connect). A second host this same
# service answers (deploy/nginx.conf has its server). It is written into
# every token for good: set it before the first service is registered and
# never change it. Left out, the account lives under the store's root.
ULTRASTORE_PORTAL_ACCOUNT_URL=https://account.ultraos.eu
# What the account calls itself on that host and in its mails.
ULTRASTORE_PORTAL_ACCOUNT_NAME=ULTRA OS account
# The key the identity tokens are signed with: a PEM file only the service's
# user reads (openssl genrsa -out /etc/ultrastore-portal-oidc.pem 2048);
# empty: one is made on first use and kept in the database. And the secret a
# person's subject is derived with; empty: made once and kept in the
# database. It must never change - keep it in every backup.
# Leaving an account: the days a closed account is kept to be reactivated,
# and the days a deletion that was asked for waits. Then it is erased, by
#   ultrastore-portal accounts maintain     (run it daily)
ULTRASTORE_PORTAL_ACCOUNT_CLOSED_DAYS=365
ULTRASTORE_PORTAL_ACCOUNT_DELETION_GRACE_DAYS=90
ULTRASTORE_PORTAL_OIDC_KEY_FILE=
ULTRASTORE_PORTAL_OIDC_SUBJECT_SECRET=

# Django's secret (sessions, the mailed links): python3 -c "import secrets; print(secrets.token_urlsafe(64))"
ULTRASTORE_PORTAL_SECRET_KEY=

# The database: MySQL in production (pip install 'ultrastore-portal[mysql]');
# postgresql://... works too ([postgres]); sqlite:///path is for tests and development only.
ULTRASTORE_PORTAL_DB=mysql://ultrastore_portal:password@127.0.0.1:3306/ultrastore_portal

# What the portal keeps on disk: media/ (icons and screenshots, public),
# packages/ (every upload under its hash, never served), public/ (the publish
# folder: v1/catalog.json, v1/packages/, v1/restricted/), static/.
ULTRASTORE_PORTAL_DATA_DIR=/var/lib/ultrastore-portal
ULTRASTORE_PORTAL_MAX_PACKAGE_MB=512
ULTRASTORE_PORTAL_MAX_IMAGE_MB=8
ULTRASTORE_PORTAL_MAX_SCREENSHOTS=8

# The mail the confirmation links, the password resets and the review's
# decisions go out by (smtp://user:password@host:587, smtps://...:465); empty
# prints them to the log.
ULTRASTORE_PORTAL_SMTP_URL=
ULTRASTORE_PORTAL_MAIL_FROM=UltraStore <noreply@store.ultraos.eu>

# The catalog: the operator's signing seed (32 bytes, hex; empty: made on the
# first publish and kept in the database), more keys for trusted_keys
# (comma-separated, a key being rotated in), and the sequence to count on from
# when a catalog was already published at this address.
ULTRASTORE_PORTAL_SIGNING_SEED=
ULTRASTORE_PORTAL_TRUSTED_KEYS=
ULTRASTORE_PORTAL_SEQUENCE_FLOOR=0

# Buying. The provider: skrill (Skrill Quick Checkout), or empty - the store
# then shows the prices, sells nothing and names no payment service in the
# catalog. (test is a developer's machine's: it needs ULTRASTORE_PORTAL_DEBUG=1.)
ULTRASTORE_PORTAL_PAYMENT_PROVIDER=
# The Skrill merchant account: where the money goes, the secret word the status
# reports are signed with, the merchant id, and the API password for refunds
# and for ending a recurring payment (the merchant portal, Developer settings;
# the server's address must be allowed there for the API).
ULTRASTORE_PORTAL_SKRILL_PAY_TO_EMAIL=
ULTRASTORE_PORTAL_SKRILL_SECRET_WORD=
ULTRASTORE_PORTAL_SKRILL_MERCHANT_ID=
ULTRASTORE_PORTAL_SKRILL_API_PASSWORD=
# The licence key's seed (32 bytes, hex; empty: made on the first sale and kept
# in the database) and the days a subscription's licence outlasts its paid
# period while a failed renewal is retried.
ULTRASTORE_PORTAL_LICENCE_SEED=
ULTRASTORE_PORTAL_GRACE_DAYS=7
# The store's fee: the percentage of what a buyer pays that the store keeps
# (from 0 to under 100, at most two decimals); the rest is the publisher's
# share. It is written on each payment, so a change applies to later sales.
ULTRASTORE_PORTAL_STORE_FEE_PERCENT=15
# Tax: the store as the seller on every invoice. Until all four are set no
# VAT is reckoned and no invoice written. The address's lines are separated
# by "|". Then load and CHECK the VAT rates:
#   ultrastore-portal money seed-rates     and the operator's Tax page
#ULTRASTORE_PORTAL_SELLER_NAME=ULTRA OS Project
#ULTRASTORE_PORTAL_SELLER_ADDRESS=Street 1|12345 Town|Country
#ULTRASTORE_PORTAL_SELLER_VAT_ID=
#ULTRASTORE_PORTAL_SELLER_COUNTRY=DE
#ULTRASTORE_PORTAL_INVOICE_PREFIX=UO-
# Payouts: the days a sale waits before its share can be paid out, and the
# least a payout is made for (a smaller sum is carried). Make them monthly:
#   ultrastore-portal money payouts        (for the last day of last month)
ULTRASTORE_PORTAL_PAYOUT_HOLD_DAYS=30
ULTRASTORE_PORTAL_PAYOUT_MINIMUM=0.01

# Affiliates (UltraAffiliates: product links, the customer's binding, the
# holdback and the monthly payouts). 1 switches it on.
# The base commission comes out of the store's fee; a publisher's boost out
# of the publisher's proceeds. Run daily:
#   ultrastore-portal affiliates maintain
# and monthly, for the month before:
#   ultrastore-portal affiliates payouts
ULTRASTORE_PORTAL_AFFILIATES=0
ULTRASTORE_PORTAL_AFFILIATE_BASE_PERCENT=5
ULTRASTORE_PORTAL_AFFILIATE_SUPER_PERCENT=10
ULTRASTORE_PORTAL_AFFILIATE_LINK_DAYS=90
ULTRASTORE_PORTAL_AFFILIATE_APPROVAL_DAYS=30
# The win-back: a customer who paid for nothing in this many months and buys
# within this many days of following an affiliate's link becomes theirs.
ULTRASTORE_PORTAL_AFFILIATE_WINBACK_MONTHS=6
ULTRASTORE_PORTAL_AFFILIATE_WINBACK_DAYS=14
# Of every approved commission this share is held back for this many months
# from the sale, against a refund or a chargeback that comes late. A balance
# under the minimum is carried to the next month's payout.
ULTRASTORE_PORTAL_AFFILIATE_HOLDBACK_PERCENT=5
ULTRASTORE_PORTAL_AFFILIATE_HOLDBACK_MONTHS=6
ULTRASTORE_PORTAL_AFFILIATE_PAYOUT_MINIMUM=25.00
# A text message (the code that proves an affiliate's phone number): one
# POST with `to` and `text` to this https address, with this bearer token.
# Unset: the operator confirms the number at the review.
#ULTRASTORE_PORTAL_TEXT_GATEWAY_URL=
#ULTRASTORE_PORTAL_TEXT_GATEWAY_TOKEN=
# A buyer's download link: the secret nginx checks it with (the same value in
# the server's secure_link_md5, deploy/nginx.conf) and its lifetime in seconds.
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ULTRASTORE_PORTAL_RESTRICTED_SECRET=
ULTRASTORE_PORTAL_RESTRICTED_TTL=600

# Advertising (UltraAds): sponsored listings in the store. 1 switches it on;
# anything else and there is no Promote button, no page of it and no
# advertisement. Paying money into an advertising balance is a second switch:
# leave it off until the store writes tax invoices - a balance then comes
# from the operator's vouchers (the operator's Advertising page).
ULTRASTORE_PORTAL_PROMOTE=0
ULTRASTORE_PORTAL_PROMOTE_TOPUPS=0
ULTRASTORE_PORTAL_PROMOTE_CURRENCY=EUR

# Where a visitor without the UltraStore app gets it: a path under the root
# (the app page's "Get the UltraStore app"); empty hides the link.
ULTRASTORE_PORTAL_STORE_DOWNLOAD_PATH=
