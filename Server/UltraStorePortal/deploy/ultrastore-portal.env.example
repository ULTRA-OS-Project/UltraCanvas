# /etc/ultrastore-portal.env - the portal's settings. Readable by root and the
# service's user only (chmod 640).

# The one root the store lives under: every URL the portal writes - the
# catalog's packages and pictures, the links in a mail - is this root plus a
# path. Leave it out and it is https://store.ultraos.eu.
ULTRASTORE_PORTAL_BASE_URL=https://store.ultraos.eu
# Django's secret (sessions, the mailed links): python3 -c "import secrets; print(secrets.token_urlsafe(64))"
ULTRASTORE_PORTAL_SECRET_KEY=

# The database: PostgreSQL in production (pip install 'ultrastore-portal[postgres]');
# mysql://... works too ([mysql]); sqlite:///path is for tests and development only.
ULTRASTORE_PORTAL_DB=postgresql://ultrastore_portal:password@127.0.0.1:5432/ultrastore_portal

# What the portal keeps on disk: media/ (icons and screenshots, public),
# packages/ (every upload under its hash, never served), public/ (the publish
# folder: v1/catalog.json, v1/packages/, v1/restricted/), static/.
ULTRASTORE_PORTAL_DATA_DIR=/var/lib/ultrastore-portal
ULTRASTORE_PORTAL_MAX_PACKAGE_MB=512
ULTRASTORE_PORTAL_MAX_IMAGE_MB=8
ULTRASTORE_PORTAL_MAX_SCREENSHOTS=8

# The mail the confirmation links, the password resets and the review's
# decisions go out by (smtp://user:password@host:587, smtps://...:465); empty
# prints them to the log.
ULTRASTORE_PORTAL_SMTP_URL=
ULTRASTORE_PORTAL_MAIL_FROM=UltraStore <noreply@store.ultraos.eu>

# The catalog: the operator's signing seed (32 bytes, hex; empty: made on the
# first publish and kept in the database), more keys for trusted_keys
# (comma-separated, a key being rotated in), and the sequence to count on from
# when a catalog was already published at this address.
ULTRASTORE_PORTAL_SIGNING_SEED=
ULTRASTORE_PORTAL_TRUSTED_KEYS=
ULTRASTORE_PORTAL_SEQUENCE_FLOOR=0

# Where a visitor without the UltraStore app gets it: a path under the root
# (the app page's "Get the UltraStore app"); empty hides the link.
ULTRASTORE_PORTAL_STORE_DOWNLOAD_PATH=
