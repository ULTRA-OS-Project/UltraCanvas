[Unit]
Description=UltraStore account service
After=network.target mariadb.service mysql.service

[Service]
User=ultrastore
Group=ultrastore
EnvironmentFile=/etc/ultrastore-account.env
WorkingDirectory=/opt/ultrastore-account
ExecStart=/opt/ultrastore-account/.venv/bin/ultrastore-account
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ultrastore-account

[Install]
WantedBy=multi-user.target
