# /etc/ultrastore-account.env - the account service's settings. Readable by
# root and the service's user only (chmod 640).
# The database: MySQL in production (pip install 'ultrastore-account[mysql]'); PostgreSQL
# works too; sqlite:///path is for tests and development only.
ULTRASTORE_ACCOUNT_DB=mysql://ultrastore_account:password@127.0.0.1:3306/ultrastore_account
ULTRASTORE_ACCOUNT_HOST=127.0.0.1
ULTRASTORE_ACCOUNT_PORT=8793
ULTRASTORE_ACCOUNT_BASE_URL=https://store.example/account
# The operator's bearer token (the operator's window and command line).
ULTRASTORE_ACCOUNT_OPERATOR_TOKEN=
# The payment service's licence key (its GET /v1/keys): a licence attached to an account
# is verified with it.
ULTRASTORE_ACCOUNT_LICENCE_KEY=
# The mail the codes and notices go out by; empty writes them to the log (development only).
ULTRASTORE_ACCOUNT_SMTP_URL=smtp://user:password@mail.example:587
ULTRASTORE_ACCOUNT_MAIL_FROM=UltraStore <noreply@store.example>
# A session not used this many days is signed out; a mailed code is good this many minutes;
# a requested deletion is carried out after this many days; a licence that names no seats
# may be installed on this many machines.
ULTRASTORE_ACCOUNT_SESSION_IDLE_DAYS=90
ULTRASTORE_ACCOUNT_CODE_MINUTES=10
ULTRASTORE_ACCOUNT_DELETION_GRACE_DAYS=30
ULTRASTORE_ACCOUNT_DEFAULT_SEATS=3
# UltraAccount (0.3.0). The key the escrowed recovery keys are sealed with at rest: 32 bytes,
# hex (python3 -c "import secrets; print(secrets.token_hex(32))"); empty refuses every
# recovery key. Keep a copy apart from the database backups: without it no key is released.
ULTRASTORE_ACCOUNT_ESCROW_KEY=
# The SMS gateway the phone and recovery codes go out by (https only), its bearer token and
# the sender; empty writes the texts to the log (development only).
ULTRASTORE_ACCOUNT_SMS_URL=
ULTRASTORE_ACCOUNT_SMS_TOKEN=
ULTRASTORE_ACCOUNT_SMS_FROM=UltraAccount
# The payment service's app id whose licence is the paid plan, and how many recovery codes
# an account may be sent in a day.
ULTRASTORE_ACCOUNT_SUBSCRIPTION_APP=UltraAccountPlus
ULTRASTORE_ACCOUNT_RECOVERY_CODES_PER_DAY=5
