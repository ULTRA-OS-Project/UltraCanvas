ISO-10303-21;
/* A quarter-cylinder sheet, radius 5 by height 10, whose surface is a
   *rational* B-spline rather than a cylindrical_surface.

   That distinction is the whole point of this sample. A rational NURBS has no
   simple entity in STEP - it can only be written as a complex instance, the
   parenthesised pile of records below - so a reader that handles only simple
   instances reads no curved freeform geometry at all. The middle column of
   control points carries weight cos(45 degrees), which is what makes the patch
   an exact circular arc rather than a parabola: the meshed area can therefore
   be checked against 2*pi*r/4 * h to the last digit the tolerance allows.

   The face is bounded by circular arcs and lines that lie on the patch but
   carry no pcurves, so the reader has to invert the surface numerically to
   find where they run in (u, v). */
HEADER;
FILE_DESCRIPTION(('A rational NURBS sheet'),'2;1');
FILE_NAME('NurbsSheet.step','2026-09-10T00:00:00',('UltraCanvas'),(''),
  'hand-authored','hand-authored','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 }'));
ENDSEC;
DATA;

#900 = APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#901 = APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#900);
#902 = PRODUCT_CONTEXT('',#900,'mechanical');
#903 = PRODUCT('Sheet','Quarter cylinder sheet','',(#902));
#904 = PRODUCT_DEFINITION_FORMATION('','',#903);
#905 = PRODUCT_DEFINITION_CONTEXT('part definition',#900,'design');
#906 = PRODUCT_DEFINITION('design','',#904,#905);
#907 = PRODUCT_DEFINITION_SHAPE('','',#906);
#908 = SHAPE_DEFINITION_REPRESENTATION(#907,#800);

#910 = ( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#911 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#912 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#913 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#910,
  'distance_accuracy_value','confusion accuracy');
#914 = ( GEOMETRIC_REPRESENTATION_CONTEXT(3)
  GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#913))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#910,#911,#912))
  REPRESENTATION_CONTEXT('Context','3D') );

#800 = MANIFOLD_SURFACE_SHAPE_REPRESENTATION('Sheet',(#201),#914);
#201 = SHELL_BASED_SURFACE_MODEL('Sheet',(#200));
#200 = OPEN_SHELL('',(#172));

#1 = DIRECTION('',(0.,0.,1.));
#2 = DIRECTION('',(1.,0.,0.));

/* --- the control net, column by column in u --- */
#20 = CARTESIAN_POINT('',(5.,0.,0.));
#21 = CARTESIAN_POINT('',(5.,0.,10.));
#22 = CARTESIAN_POINT('',(5.,5.,0.));
#23 = CARTESIAN_POINT('',(5.,5.,10.));
#24 = CARTESIAN_POINT('',(0.,5.,0.));
#25 = CARTESIAN_POINT('',(0.,5.,10.));

#40 = ( BOUNDED_SURFACE()
  B_SPLINE_SURFACE(2,1,((#20,#21),(#22,#23),(#24,#25)),.UNSPECIFIED.,.F.,.F.,.F.)
  B_SPLINE_SURFACE_WITH_KNOTS((3,3),(2,2),(0.,1.),(0.,1.),.UNSPECIFIED.)
  GEOMETRIC_REPRESENTATION_ITEM()
  RATIONAL_B_SPLINE_SURFACE(((1.,1.),(0.7071067811865476,0.7071067811865476),(1.,1.)))
  REPRESENTATION_ITEM('') SURFACE() );

/* --- the boundary: two arcs and two rulings, no pcurves --- */
#50 = CARTESIAN_POINT('',(0.,0.,0.));
#51 = CARTESIAN_POINT('',(0.,0.,10.));
#52 = AXIS2_PLACEMENT_3D('',#50,#1,#2);
#53 = AXIS2_PLACEMENT_3D('',#51,#1,#2);
#54 = CIRCLE('',#52,5.);
#55 = CIRCLE('',#53,5.);
#56 = VECTOR('',#1,10.);
#57 = LINE('',#20,#56);
#58 = LINE('',#24,#56);

#60 = VERTEX_POINT('',#20);
#61 = VERTEX_POINT('',#24);
#62 = VERTEX_POINT('',#21);
#63 = VERTEX_POINT('',#25);

#70 = EDGE_CURVE('',#60,#61,#54,.T.);
#71 = EDGE_CURVE('',#61,#63,#58,.T.);
#72 = EDGE_CURVE('',#62,#63,#55,.T.);
#73 = EDGE_CURVE('',#60,#62,#57,.T.);

#1701 = ORIENTED_EDGE('',*,*,#70,.T.);
#1702 = ORIENTED_EDGE('',*,*,#71,.T.);
#1703 = ORIENTED_EDGE('',*,*,#72,.F.);
#1704 = ORIENTED_EDGE('',*,*,#73,.F.);
#170 = EDGE_LOOP('',(#1701,#1702,#1703,#1704));
#171 = FACE_OUTER_BOUND('',#170,.T.);
#172 = ADVANCED_FACE('sheet',(#171),#40,.T.);

ENDSEC;
END-ISO-10303-21;
