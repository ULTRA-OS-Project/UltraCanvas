%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 300 300
%%Title: Gears
%%Creator: UltraCanvas Framework
%%EndComments
% Two meshing gears drawn by one procedure — exercises arcs, rotation
% loops, gray and RGB fills, and even-odd-free hub holes via arcn.

/tooth {
    % draw one tooth of unit outer radius, from -8 to 8 degrees
    newpath
    0 0 100 -7 7 arc
    0 0 118 9 21 arc
    closepath fill
} def

/gear { % nteeth r g b -> draws centered gear of outer radius ~118
    setrgbcolor
    /n exch def
    gsave
    0 1 n 1 sub {
        pop
        360 n div rotate
        tooth
    } for
    newpath 0 0 104 0 360 arc fill
    1 setgray newpath 0 0 30 0 360 arc fill
    grestore
} def

gsave 95 190 translate 0.72 0.72 scale
12 0.75 0.2 0.15 gear
grestore
gsave 216 118 translate 0.5 0.5 scale 15 rotate
9 0.15 0.35 0.75 gear
grestore

0.25 setgray
/Courier-Bold findfont 16 scalefont setfont
78 20 moveto (media/eps/gears) show
showpage
%%EOF
