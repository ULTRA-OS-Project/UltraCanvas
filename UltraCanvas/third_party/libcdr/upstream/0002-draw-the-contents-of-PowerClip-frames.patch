+void libcdr::CDRContentCollector::collectPowerClip(unsigned id)
+{
+  m_powerClipId = id;
+}
+
+// Draws a PowerClip frame's contents. They were rendered into
+// their vect's own SVG (m_ps.m_vects) in the vect's box; that SVG goes back
+// on the page as an image over exactly that box, wrapped in an SVG of its
+// own whose clipPath is the frame's outline - so the contents are clipped
+// to the frame the way CorelDRAW draws them, for any SVG consumer.
+void libcdr::CDRContentCollector::_addPowerClipContent(CDROutputElementList &outputElement,
+                                                        const std::vector<librevenge::RVNGPropertyList> &framePath)
+{
+  auto vect = m_ps.m_vects.find(m_powerClipId);
+  auto box = m_ps.m_vectBoxes.find(m_powerClipId);
+  if (vect == m_ps.m_vects.end() || box == m_ps.m_vectBoxes.end() || framePath.empty())
+    return;
+  const CDRPage &content = box->second;
+  if (CDR_ALMOST_ZERO(content.width) || CDR_ALMOST_ZERO(content.height))
+    return;
+
+  // The contents' box on the output page (the same shift and Y flip the
+  // frame's path went through).
+  const double x0 = content.offsetX - m_page.offsetX;
+  const double y0 = m_page.height - (content.offsetY + content.height - m_page.offsetY);
+  const double w = content.width;
+  const double h = content.height;
+  const double pt = 72.0; // the nested SVG is in points, like the generator's output
+
+  // The frame's outline in the box's coordinates.
+  librevenge::RVNGString d;
+  auto num = [&](double v, double origin) -> librevenge::RVNGString
+  {
+    librevenge::RVNGString t;
+    t.sprintf("%.4f", (v - origin) * pt);
+    return t;
+  };
+  for (const auto &node : framePath)
+  {
+    if (!node["librevenge:path-action"])
+      continue;
+    const librevenge::RVNGString action = node["librevenge:path-action"]->getStr();
+    if (action == "Z")
+    {
+      d.append("Z ");
+      continue;
+    }
+    if (!node["svg:x"] || !node["svg:y"])
+      continue;
+    d.append(action);
+    d.append(" ");
+    if ((action == "C" || action == "Q") && node["svg:x1"] && node["svg:y1"])
+    {
+      d.append(num(node["svg:x1"]->getDouble(), x0)); d.append(" ");
+      d.append(num(node["svg:y1"]->getDouble(), y0)); d.append(" ");
+      if (action == "C" && node["svg:x2"] && node["svg:y2"])
+      {
+        d.append(num(node["svg:x2"]->getDouble(), x0)); d.append(" ");
+        d.append(num(node["svg:y2"]->getDouble(), y0)); d.append(" ");
+      }
+    }
+    else if (action == "A" && node["svg:rx"] && node["svg:ry"])
+    {
+      librevenge::RVNGString arc;
+      arc.sprintf("%.4f %.4f %.4f %d %d ", node["svg:rx"]->getDouble() * pt, node["svg:ry"]->getDouble() * pt,
+                  node["librevenge:rotate"] ? node["librevenge:rotate"]->getDouble() : 0.0,
+                  node["librevenge:large-arc"] ? node["librevenge:large-arc"]->getInt() : 0,
+                  node["librevenge:sweep"] ? node["librevenge:sweep"]->getInt() : 0);
+      d.append(arc);
+    }
+    d.append(num(node["svg:x"]->getDouble(), x0)); d.append(" ");
+    d.append(num(node["svg:y"]->getDouble(), y0)); d.append(" ");
+  }
+
+  librevenge::RVNGString svg;
+  svg.sprintf("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+              "<svg xmlns=\"http://www.w3.org/2000/svg\" xmlns:xlink=\"http://www.w3.org/1999/xlink\" "
+              "width=\"%.4f\" height=\"%.4f\" viewBox=\"0 0 %.4f %.4f\">"
+              "<defs><clipPath id=\"powerclip\"><path d=\"", w * pt, h * pt, w * pt, h * pt);
+  svg.append(d);
+  librevenge::RVNGString tail;
+  tail.sprintf("\"/></clipPath></defs><g clip-path=\"url(#powerclip)\">"
+               "<image x=\"0\" y=\"0\" width=\"%.4f\" height=\"%.4f\" preserveAspectRatio=\"none\" "
+               "xlink:href=\"data:image/svg+xml;base64,", w * pt, h * pt);
+  svg.append(tail);
+  svg.append(vect->second.getBase64Data());
+  svg.append("\"/></g></svg>");
+
+  librevenge::RVNGPropertyList style;
+  style.insert("draw:stroke", "none");
+  style.insert("draw:fill", "none");
+  outputElement.addStyle(style);
+  librevenge::RVNGPropertyList image;
+  image.insert("svg:x", x0);
+  image.insert("svg:y", y0);
+  image.insert("svg:width", w);
+  image.insert("svg:height", h);
+  image.insert("librevenge:mime-type", "image/svg+xml");
+  image.insert("office:binary-data", librevenge::RVNGBinaryData((const unsigned char *)svg.cstr(), svg.size()));
+  outputElement.addGraphicObject(image);
+}
