diff --git a/src/lib/CDRParser.cpp b/src/lib/CDRParser.cpp
index 7690725..06f2c67 100644
--- a/src/lib/CDRParser.cpp
+++ b/src/lib/CDRParser.cpp
@@ -1973,6 +1973,31 @@ void libcdr::CDRParser::readBmp(librevenge::RVNGInputStream *input, unsigned len
   std::vector<unsigned> palette;
   readRImage(colorModel, width, height, bpp, palette, bitmap, input);
   m_collector->collectBmp(imageId, colorModel, width, height, bpp, palette, bitmap);
+
+  // A bitmap with transparency is followed by its 8-bit alpha mask, an
+  // image record of its own with colour model 99. The mask record starts a few
+  // bytes after the colour data (14 in every file seen); look for its header
+  // - model 99, 1, same width and height, 1, 8 bpp - within a short window.
+  const long afterColour = input->tell();
+  for (long gap = 0; gap <= 64; gap += 2)
+  {
+    input->seek(afterColour + gap, librevenge::RVNG_SEEK_SET);
+    if (getRemainingLength(input) < 64)
+      break;
+    if (readU32(input) != 99 || readU32(input) != 1 || readU32(input) != width || readU32(input) != height ||
+        readU32(input) != 1 || readU32(input) != 8)
+      continue;
+    const unsigned stride = readU32(input);
+    const unsigned size = readU32(input);
+    if (stride < width || size != stride * height || size > getRemainingLength(input))
+      break;
+    input->seek(32, librevenge::RVNG_SEEK_CUR);
+    unsigned long numRead = 0;
+    const unsigned char *data = input->read(size, numRead);
+    if (numRead == size)
+      m_collector->collectBmpAlpha(imageId, width, height, stride, std::vector<unsigned char>(data, data + size));
+    break;
+  }
 }
 
 void libcdr::CDRParser::readOpacity(librevenge::RVNGInputStream *input, unsigned /* length */)
