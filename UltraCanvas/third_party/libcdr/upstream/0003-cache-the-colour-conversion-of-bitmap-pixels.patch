From 0b5d58a30a2f6067a203e7c678e31ece8cd6ad30 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 27 Oct 2026 14:00:24 +0000
Subject: [PATCH 3/3] cache the colour conversion of bitmap pixels

collectBmp converts every pixel of an embedded bitmap through
getBMPColor, and for most colour models that is one lcms cmsDoTransform
call per pixel. On a drawing with a few embedded photos that is most of
the time the whole parse takes (about 70% of it on a 3.3 MB sample with
six bitmaps).

The result depends only on the colour model, the value and the colour
transforms, so getBMPColor now keeps it: the last colour for the runs of
equal pixels, and a hash map of the others, emptied when
setColorTransform installs new transforms and when it reaches a million
entries. The output is unchanged; on the sample the parse takes a third
of the time it did.
---
 src/lib/CDRCollector.cpp | 30 ++++++++++++++++++++++++++++++
 src/lib/CDRCollector.h   | 11 +++++++++++
 2 files changed, 41 insertions(+)

diff --git a/src/lib/CDRCollector.cpp b/src/lib/CDRCollector.cpp
index 7adffc1..a6ed15c 100644
--- a/src/lib/CDRCollector.cpp
+++ b/src/lib/CDRCollector.cpp
@@ -46,6 +46,9 @@ void libcdr::CDRParserState::setColorTransform(const std::vector<unsigned char>
 {
   if (profile.empty())
     return;
+  // Colours converted through the old transforms are stale.
+  m_bmpColorCache.clear();
+  m_lastBmpColorKey = ~0ULL;
   cmsHPROFILE tmpProfile = cmsOpenProfileFromMem(&profile[0], cmsUInt32Number(profile.size()));
   if (!tmpProfile)
     return;
@@ -88,6 +91,33 @@ void libcdr::CDRParserState::setColorTransform(librevenge::RVNGInputStream *inpu
 }
 
 unsigned libcdr::CDRParserState::getBMPColor(const CDRColor &color)
+{
+  // A bitmap converts every pixel here, one lcms call each - most of the
+  // time it takes to open a drawing with a few embedded photos. Its pixels
+  // repeat their colours, so each conversion is kept (up to a million
+  // colours, then the cache starts again).
+  const unsigned long long key = ((unsigned long long)color.m_colorModel << 32) | color.m_colorValue;
+  if (key == m_lastBmpColorKey)
+    return m_lastBmpColor;
+  unsigned rgb;
+  const std::unordered_map<unsigned long long, unsigned>::const_iterator it = m_bmpColorCache.find(key);
+  if (it != m_bmpColorCache.end())
+  {
+    rgb = it->second;
+  }
+  else
+  {
+    rgb = _getBMPColor(color);
+    if (m_bmpColorCache.size() >= (1u << 20))
+      m_bmpColorCache.clear();
+    m_bmpColorCache[key] = rgb;
+  }
+  m_lastBmpColorKey = key;
+  m_lastBmpColor = rgb;
+  return rgb;
+}
+
+unsigned libcdr::CDRParserState::_getBMPColor(const CDRColor &color)
 {
   switch (color.m_colorModel)
   {
diff --git a/src/lib/CDRCollector.h b/src/lib/CDRCollector.h
index dca1ee9..8fb8da8 100644
--- a/src/lib/CDRCollector.h
+++ b/src/lib/CDRCollector.h
@@ -11,6 +11,7 @@
 #define __CDRCOLLECTOR_H__
 
 #include <map>
+#include <unordered_map>
 #include <utility>
 #include <vector>
 
@@ -57,6 +58,16 @@ public:
   void getRecursedStyle(CDRStyle &style, unsigned styleId);
 
 private:
+  // getBMPColor's results, keyed by colour model and value. Every pixel of
+  // a bitmap goes through getBMPColor, and most models go through an lcms
+  // transform one pixel at a time; the result depends only on the model,
+  // the value and the transforms (setColorTransform empties the cache).
+  std::unordered_map<unsigned long long, unsigned> m_bmpColorCache;
+  // ... and the last one, for the run of equal pixels most rows are.
+  unsigned long long m_lastBmpColorKey = ~0ULL;
+  unsigned m_lastBmpColor = 0;
+  unsigned _getBMPColor(const CDRColor &color);
+
   CDRParserState(const CDRParserState &);
   CDRParserState &operator=(const CDRParserState &);
 };
