// Template app/build.gradle for an UltraCanvas Android app.
//
// NEVER RUN. The cross-compiled dependency sysroot it points at builds for
// arm64-v8a in CI (scripts/android-bootstrap-sysroot.sh, see README.md in this
// directory), but no APK has been built with this file. Treat it as a
// checklist of the settings the backend needs, not as a working build file.

plugins {
    id 'com.android.application'
}

android {
    namespace 'org.ultraos.ultracanvas.demo'
    // API 26 is the backend's floor: ClipDescription.getTimestamp (clipboard
    // change detection) and the SAF behaviour it relies on are 26+.
    compileSdk 34

    defaultConfig {
        applicationId 'org.ultraos.ultracanvas.demo'
        minSdk 26
        targetSdk 34
        versionCode 1
        versionName '1.0'

        externalNativeBuild {
            cmake {
                // x86_64 FIRST, arm64 second - the opposite of what shipping
                // order suggests, and deliberate: nothing on an x86_64 Linux
                // desktop or CI runner can run an arm64-only APK without an
                // unofficial translation layer or whole-CPU emulation, so an
                // arm64-first build has nowhere to run until a phone is in the
                // room. Build 'x86_64' alone until the pipeline works end to
                // end, then add back 'arm64-v8a' - which is what ships.
                // Every extra ABI multiplies both build time and the sysroot
                // you must cross-compile
                // (Docs/UltraCanvas/AndroidOnLinuxInvestigation.md section 3).
                abiFilters 'x86_64'
                arguments '-DANDROID_PLATFORM=android-26',
                          '-DANDROID_STL=c++_shared',
                          // The cross-compiled sysroot, from
                          // scripts/android-bootstrap-sysroot.sh for this ABI
                          // (CI has built arm64-v8a only). Its libraries are
                          // static, so pkg-config asks for static link lists.
                          // PKG_CONFIG_LIBDIR must point at its pkgconfig
                          // directories too (the script prints it).
                          "-DCMAKE_FIND_ROOT_PATH=${project.properties['ultracanvas.sysroot'] ?: ''}",
                          '-DPKG_CONFIG_ARGN=--static'
            }
        }
    }

    externalNativeBuild {
        cmake {
            // The repository's root CMakeLists. Its `if(ANDROID)` block
            // already defaults the desktop apps, plugins, UltraNet, database
            // and VirtualFS off, so only the core library (libvips included,
            // as on every platform) and your app are built.
            path '../../../../../CMakeLists.txt'
            version '3.22.1+'
        }
    }

    sourceSets {
        main {
            manifest.srcFile 'src/main/AndroidManifest.xml'
            // UltraCanvasActivity lives in the framework tree rather than
            // being copied into every app.
            java.srcDirs += '../../java'
            // Anything the app loads by path at runtime. Unpacked to
            // $HOME/share on first launch by UltraCanvasAndroidAssets.cpp.
            assets.srcDirs = ['src/main/assets']
            // The cross-compiled cairo/pango/glib/... .so files.
            jniLibs.srcDirs = ['src/main/jniLibs']
        }
    }

    packagingOptions {
        // The dependency .so files are already stripped and must not be
        // re-compressed, or dlopen cannot mmap them directly.
        jniLibs {
            useLegacyPackaging false
        }
    }
}
