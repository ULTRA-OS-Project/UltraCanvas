diff --git a/glib/glist.c b/glib/glist.c
index 8ba2f84..3716338 100644
--- a/glib/glist.c
+++ b/glib/glist.c
@@ -159,7 +159,14 @@ void
 g_list_free_full (GList          *list,
                   GDestroyNotify  free_func)
 {
-  g_list_foreach (list, (GFunc) free_func, NULL);
+  /* wasm: a GDestroyNotify called through a GFunc pointer traps (one
+   * argument against two), so walk the list and call it as what it is. */
+  for (GList *l = list; l != NULL; )
+    {
+      GList *next = l->next;
+      (*free_func) (l->data);
+      l = next;
+    }
   g_list_free (list);
 }
 
diff --git a/glib/gqueue.c b/glib/gqueue.c
index 07805ff..f08bff7 100644
--- a/glib/gqueue.c
+++ b/glib/gqueue.c
@@ -81,7 +81,14 @@ void
 g_queue_free_full (GQueue        *queue,
                   GDestroyNotify  free_func)
 {
-  g_queue_foreach (queue, (GFunc) free_func, NULL);
+  /* wasm: a GDestroyNotify called through a GFunc pointer traps (one
+   * argument against two), so walk the list and call it as what it is. */
+  for (GList *l = queue->head; l != NULL; )
+    {
+      GList *next = l->next;
+      (*free_func) (l->data);
+      l = next;
+    }
   g_queue_free (queue);
 }
 
@@ -140,7 +147,15 @@ g_queue_clear_full (GQueue          *queue,
   g_return_if_fail (queue != NULL);
 
   if (free_func != NULL)
-    g_queue_foreach (queue, (GFunc) free_func, NULL);
+    {
+      /* wasm: see g_queue_free_full */
+      for (GList *l = queue->head; l != NULL; )
+        {
+          GList *next = l->next;
+          (*free_func) (l->data);
+          l = next;
+        }
+    }
 
   g_queue_clear (queue);
 }
