@@ -986,6 +995,39 @@
 
   return NULL;
 }
+#endif /* !PANGO_FC_NO_THREAD */
+
+/* Hand a job to the fontconfig worker, or do it here when there is none. */
+static void
+queue_fc_job (GAsyncQueue *queue, ThreadData *td)
+{
+#ifdef PANGO_FC_NO_THREAD
+  (void) queue;
+  switch (td->op)
+    {
+    case FC_INIT:
+      init_in_thread (td);
+      break;
+
+    case FC_MATCH:
+      match_in_thread (td);
+      break;
+
+    case FC_SORT:
+      sort_in_thread (td);
+      break;
+
+    case FC_END:
+      thread_data_free (td);
+      break;
+
+    default:
+      g_assert_not_reached ();
+    }
+#else
+  g_async_queue_push (queue, td);
+#endif
+}
 
