@@ -120,6 +120,14 @@
 static GCond fc_init_cond;
 static DefaultConfig fc_initialized = DEFAULT_CONFIG_NOT_INITIALIZED;
 
+/* A WebAssembly program built without -pthread cannot start the fontconfig
+ * worker: Emscripten answers pthread_create with ENOTSUP, and GLib treats
+ * that as a programming error and aborts. With PANGO_FC_NO_THREAD defined
+ * (the sysroot script passes it for a build without threads) every job the
+ * queue would hand the worker runs on the caller's thread instead; the
+ * waits below then find their result already there.
+ */
+
 
 typedef struct _PangoFcFontFaceData PangoFcFontFaceData;
 typedef struct _PangoFcFace         PangoFcFace;
