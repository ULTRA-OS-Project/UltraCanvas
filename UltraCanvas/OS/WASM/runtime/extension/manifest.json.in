{
  "manifest_version": 3,
  "name": "UltraCanvas",
  "version": "@ULTRACANVAS_VERSION@",
  "description": "Runs UltraCanvas WebAssembly apps with UltraCanvas installed once, so a site sends only its app, not the framework.",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["ultracanvas-announce.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["runtime/*"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ultracanvas-runtime@ultraos.eu",
      "strict_min_version": "128.0"
    }
  }
}
