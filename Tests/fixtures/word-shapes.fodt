<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:loext="urn:org:documentfoundation:names:experimental:office:xmlns:loext:1.0" xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
<office:styles>
 <style:default-style style:family="paragraph"><style:text-properties style:font-name="Liberation Sans" fo:font-family="'Liberation Sans'" fo:font-size="11pt"/></style:default-style>
 <style:style style:name="Standard" style:family="paragraph"><style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.2cm"/></style:style>
 <draw:marker draw:name="Arrow" svg:viewBox="0 0 20 30" svg:d="M10 0l-10 30h20z"/>
 <draw:stroke-dash draw:name="Dash" draw:style="rect" draw:dots1="1" draw:dots1-length="0.2cm" draw:distance="0.15cm"/>
</office:styles>
<office:automatic-styles>
 <style:style style:name="gRule" style:family="graphic"><style:graphic-properties style:wrap="none" style:horizontal-pos="from-left" style:horizontal-rel="paragraph" style:vertical-pos="from-top" style:vertical-rel="paragraph" draw:fill="none" draw:stroke="solid" svg:stroke-color="#1f4e79" svg:stroke-width="1.5pt"/></style:style>
 <style:style style:name="gBox" style:family="graphic"><style:graphic-properties style:wrap="parallel" style:number-wrapped-paragraphs="no-limit" style:horizontal-pos="right" style:horizontal-rel="paragraph" style:vertical-pos="from-top" style:vertical-rel="paragraph" draw:fill="solid" draw:fill-color="#ffe699" draw:stroke="solid" svg:stroke-color="#c00000" svg:stroke-width="1pt" draw:textarea-vertical-align="middle" draw:textarea-horizontal-align="center" fo:padding-left="0.1cm" fo:padding-right="0.1cm" fo:padding-top="0.1cm" fo:padding-bottom="0.1cm"/></style:style>
 <style:style style:name="gEllipse" style:family="graphic"><style:graphic-properties style:wrap="parallel" style:number-wrapped-paragraphs="no-limit" style:horizontal-pos="from-left" style:horizontal-rel="paragraph" style:vertical-pos="from-top" style:vertical-rel="paragraph" draw:fill="solid" draw:fill-color="#70ad47" draw:stroke="none"/></style:style>
 <style:style style:name="gArrow" style:family="graphic"><style:graphic-properties style:wrap="none" style:horizontal-pos="from-left" style:horizontal-rel="paragraph" style:vertical-pos="from-top" style:vertical-rel="paragraph" draw:fill="none" draw:stroke="dash" draw:stroke-dash="Dash" svg:stroke-color="#000000" svg:stroke-width="1pt" draw:marker-end="Arrow" draw:marker-end-width="0.3cm"/></style:style>
 <style:style style:name="gTriangle" style:family="graphic"><style:graphic-properties style:wrap="none" style:horizontal-pos="from-left" style:horizontal-rel="paragraph" style:vertical-pos="from-top" style:vertical-rel="paragraph" draw:fill="solid" draw:fill-color="#5b9bd5" draw:stroke="solid" svg:stroke-color="#2f5597" svg:stroke-width="0.75pt"/></style:style>
 <style:style style:name="gGroup" style:family="graphic"><style:graphic-properties style:wrap="none" style:horizontal-pos="from-left" style:horizontal-rel="paragraph" style:vertical-pos="from-top" style:vertical-rel="paragraph"/></style:style>
 <style:style style:name="gMemberBox" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#d9e2f3" draw:stroke="solid" svg:stroke-color="#4472c4" svg:stroke-width="1pt" draw:textarea-vertical-align="top" fo:padding-left="0.1cm" fo:padding-right="0.1cm" fo:padding-top="0.1cm" fo:padding-bottom="0.1cm"/></style:style>
 <style:style style:name="gMemberDot" style:family="graphic"><style:graphic-properties draw:fill="solid" draw:fill-color="#ed7d31" draw:stroke="none"/></style:style>
 <style:style style:name="gTurned" style:family="graphic"><style:graphic-properties style:wrap="none" style:horizontal-pos="from-left" style:horizontal-rel="paragraph" style:vertical-pos="from-top" style:vertical-rel="paragraph" draw:fill="solid" draw:fill-color="#a5a5a5" draw:stroke="solid" svg:stroke-color="#000000" svg:stroke-width="0.75pt"/></style:style>
 <style:page-layout style:name="PageLayout"><style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm" style:print-orientation="portrait" fo:margin-top="2cm" fo:margin-bottom="2cm" fo:margin-left="2.5cm" fo:margin-right="2cm"/></style:page-layout>
</office:automatic-styles>
<office:master-styles><style:master-page style:name="Standard" style:page-layout-name="PageLayout"/></office:master-styles>
<office:body><office:text>
 <text:p text:style-name="Standard">Drawn shapes in a word-processing document.</text:p>
 <text:p text:style-name="Standard"><draw:line draw:style-name="gRule" draw:name="Rule" text:anchor-type="paragraph" draw:z-index="0" svg:x1="0cm" svg:y1="0.1cm" svg:x2="16cm" svg:y2="0.1cm"><text:p/></draw:line>A paragraph with a rule drawn above its words.</text:p>
 <text:p text:style-name="Standard"><draw:rect draw:style-name="gBox" draw:name="Box" text:anchor-type="paragraph" draw:z-index="1" svg:y="0cm" svg:width="5cm" svg:height="2.5cm"><text:p text:style-name="Standard">Boxed words</text:p></draw:rect>This paragraph flows beside a filled rectangle with a red outline and words centred in it. This paragraph flows beside a filled rectangle with a red outline and words centred in it. This paragraph flows beside a filled rectangle with a red outline and words centred in it.</text:p>
 <text:p text:style-name="Standard"><draw:ellipse draw:style-name="gEllipse" draw:name="Ellipse" text:anchor-type="paragraph" draw:z-index="2" svg:x="0cm" svg:y="0cm" svg:width="3cm" svg:height="2cm"><text:p/></draw:ellipse>A green ellipse sits at the left of this paragraph, which wraps round it on its right side. A green ellipse sits at the left of this paragraph, which wraps round it on its right side.</text:p>
 <text:p text:style-name="Standard"><draw:line draw:style-name="gArrow" draw:name="Arrow" text:anchor-type="paragraph" draw:z-index="3" svg:x1="0cm" svg:y1="0.5cm" svg:x2="6cm" svg:y2="1.5cm"><text:p/></draw:line><draw:polygon draw:style-name="gTriangle" draw:name="Triangle" text:anchor-type="paragraph" draw:z-index="4" svg:x="8cm" svg:y="0cm" svg:width="3cm" svg:height="2cm" svg:viewBox="0 0 3000 2000" draw:points="1500,0 3000,2000 0,2000"><text:p/></draw:polygon>A dashed arrow and a triangle.</text:p>
 <text:p text:style-name="Standard"><draw:g draw:style-name="gGroup" draw:name="Group" text:anchor-type="paragraph" draw:z-index="5"><draw:rect draw:style-name="gMemberBox" draw:name="Member box" svg:x="0cm" svg:y="0cm" svg:width="6cm" svg:height="2cm"><text:p text:style-name="Standard">Group text</text:p></draw:rect><draw:ellipse draw:style-name="gMemberDot" draw:name="Member dot" svg:x="6.5cm" svg:y="0.5cm" svg:width="1cm" svg:height="1cm"><text:p/></draw:ellipse></draw:g><draw:rect draw:style-name="gTurned" draw:name="Turned" text:anchor-type="paragraph" draw:z-index="6" svg:width="3cm" svg:height="1cm" draw:transform="rotate (-0.523598775598299) translate (11.5cm 0.2cm)"><text:p/></draw:rect>A group of a box with words and a dot, and a box turned by thirty degrees.</text:p>
 <text:p text:style-name="Standard"/>
 <text:p text:style-name="Standard"/>
 <text:p text:style-name="Standard"/>
 <text:p text:style-name="Standard">Closing line after the shapes.</text:p>
</office:text></office:body></office:document>
