<html xmlns:o="urn:schemas-microsoft-com:office:office"
xmlns:x="urn:schemas-microsoft-com:office:excel"
xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta http-equiv=Content-Type content="text/html; charset=utf-8">
<meta name=ProgId content=Excel.Sheet>
<!-- An HTML table saved under an .xls name, the way web applications and
     Excel's "Save as Web Page" write one. Read by SpreadsheetXlsFileTest. -->
<style>
td {mso-number-format:General;}
.x1 {mso-number-format:"\#\,\#\#0\.00";}
</style>
</head>
<body>
<table border=0 cellpadding=0 cellspacing=0>
 <tr>
  <th>Account</th>
  <th>Amount</th>
  <th>Note</th>
 </tr>
 <tr>
  <td>Rent &amp; utilities</td>
  <td class=x1 x:num="1234.5">1,234.50</td>
  <td x:str>007</td>
 </tr>
 <tr>
  <td>&#3588;&#3656;&#3634;&#3652;&#3615;</td>
  <td align=right>-42.25</td>
  <td></td>
 </tr>
 <tr>
  <td colspan=2>Spans two columns</td>
  <td rowspan=2>Tall</td>
 </tr>
 <tr>
  <td>3.5e2</td>
  <td>12,5</td>
 </tr>
</table>
</body>
</html>
