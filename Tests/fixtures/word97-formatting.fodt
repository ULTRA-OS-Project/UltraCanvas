<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0" xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0" xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0" xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0" xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0" xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0" office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
<office:font-face-decls><style:font-face style:name="Wingdings" svg:font-family="Wingdings" style:font-charset="x-symbol"/></office:font-face-decls>
<office:styles>
 <style:default-style style:family="paragraph"><style:paragraph-properties style:tab-stop-distance="0.5in"/></style:default-style>
 <style:style style:name="Standard" style:family="paragraph"><style:text-properties style:font-name="Liberation Sans" fo:font-size="11pt"/></style:style>
 <style:style style:name="Heading_20_1" style:display-name="Heading 1" style:family="paragraph" style:parent-style-name="Standard" style:default-outline-level="1"><style:text-properties fo:font-size="18pt" fo:font-weight="bold"/></style:style>
 <text:list-style style:name="Bullets"><text:list-level-style-bullet text:level="1" text:bullet-char="•"/><text:list-level-style-bullet text:level="2" text:bullet-char="◦"/></text:list-style>
 <text:list-style style:name="Numbers"><text:list-level-style-number text:level="1" style:num-format="1" style:num-suffix="."/><text:list-level-style-number text:level="2" style:num-format="a" style:num-suffix=")"/></text:list-style>
 <text:list-style style:name="MultiLevel"><text:list-level-style-number text:level="1" style:num-format="1" style:num-suffix="."/><text:list-level-style-number text:level="2" style:num-format="1" text:display-levels="2" style:num-suffix="."/><text:list-level-style-number text:level="3" style:num-format="a" style:num-suffix=")"/></text:list-style>
 <text:list-style style:name="Roman"><text:list-level-style-number text:level="1" style:num-format="I" style:num-prefix="(" style:num-suffix=")"/></text:list-style>
 <text:list-style style:name="Dash"><text:list-level-style-bullet text:level="1" text:bullet-char="–"/></text:list-style>
 <text:list-style style:name="WingBullet"><text:list-level-style-bullet text:level="1" text:bullet-char="§"><style:text-properties style:font-name="Wingdings"/></text:list-level-style-bullet></text:list-style>
 <text:list-style style:name="FromFive"><text:list-level-style-number text:level="1" style:num-format="1" style:num-suffix="." text:start-value="5"/></text:list-style>
</office:styles>
<office:automatic-styles>
 <style:style style:name="PCenter" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:text-align="center"/></style:style>
 <style:style style:name="PRight" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:text-align="end"/></style:style>
 <style:style style:name="PIndent" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-left="1in" fo:margin-right="0.5in" fo:text-indent="0.25in" fo:margin-top="0.1667in" fo:margin-bottom="0.0833in" fo:line-height="150%"/></style:style>
 <style:style style:name="PHanging" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:margin-left="0.5in" fo:text-indent="-0.5in"/></style:style>
 <style:style style:name="PTabs" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties><style:tab-stops><style:tab-stop style:position="1in"/><style:tab-stop style:position="3in" style:type="center"/><style:tab-stop style:position="5in" style:type="right"/><style:tab-stop style:position="6in" style:type="char" style:char="."/></style:tab-stops></style:paragraph-properties></style:style>
 <style:style style:name="TWing" style:family="text"><style:text-properties style:font-name="Wingdings"/></style:style>
 <style:style style:name="PBreak" style:family="paragraph" style:parent-style-name="Standard"><style:paragraph-properties fo:break-before="page"/></style:style>
 <style:style style:name="TBold" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
 <style:style style:name="TRed" style:family="text"><style:text-properties fo:color="#c00000"/></style:style>
 <style:style style:name="TUnder" style:family="text"><style:text-properties style:text-underline-style="solid" style:text-underline-width="auto" style:text-underline-color="font-color"/></style:style>
 <style:style style:name="TStrike" style:family="text"><style:text-properties style:text-line-through-style="solid"/></style:style>
 <style:style style:name="TSup" style:family="text"><style:text-properties style:text-position="super 58%"/></style:style>
 <style:style style:name="TBig" style:family="text"><style:text-properties fo:font-size="16pt"/></style:style>
 <style:style style:name="Tbl" style:family="table"><style:table-properties style:width="6in" table:align="left"/></style:style>
 <style:style style:name="Tbl.A" style:family="table-column"><style:table-column-properties style:column-width="1.5in"/></style:style>
 <style:style style:name="Tbl.B" style:family="table-column"><style:table-column-properties style:column-width="4.5in"/></style:style>
 <style:style style:name="CHead" style:family="table-cell"><style:table-cell-properties fo:background-color="#ddeeff" fo:border="0.5pt solid #000000"/></style:style>
 <style:style style:name="CBody" style:family="table-cell"><style:table-cell-properties fo:border="0.5pt solid #000000"/></style:style>
 <style:style style:name="CThick" style:family="table-cell"><style:table-cell-properties fo:border-top="0.5pt solid #000000" fo:border-left="0.5pt solid #000000" fo:border-right="0.5pt solid #000000" fo:border-bottom="2pt solid #0000ff"/></style:style>
</office:automatic-styles>
<office:body><office:text>
 <text:h text:style-name="Heading_20_1" text:outline-level="1">Fixture Heading</text:h>
 <text:p text:style-name="Standard">Plain <text:span text:style-name="TBold">bold</text:span> <text:span text:style-name="TRed">red</text:span> <text:span text:style-name="TUnder">under</text:span> <text:span text:style-name="TStrike">struck</text:span> E=mc<text:span text:style-name="TSup">2</text:span> <text:span text:style-name="TBig">big</text:span> <text:a xlink:type="simple" xlink:href="https://example.org/doc">link text</text:a>.</text:p>
 <text:p text:style-name="PCenter">Centred line</text:p>
 <text:list text:style-name="Bullets"><text:list-item><text:p text:style-name="Standard">bullet A</text:p><text:list><text:list-item><text:p text:style-name="Standard">bullet A.1</text:p></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="Standard">bullet B</text:p></text:list-item></text:list>
 <text:list xml:id="numlist" text:style-name="Numbers"><text:list-item><text:p text:style-name="Standard">step one</text:p></text:list-item><text:list-item><text:p text:style-name="Standard">step two</text:p></text:list-item></text:list>
 <text:p text:style-name="Standard">An interrupting note.</text:p>
 <text:list text:continue-numbering="true" text:style-name="Numbers"><text:list-item><text:p text:style-name="Standard">step three</text:p></text:list-item></text:list>
 <text:list text:style-name="FromFive"><text:list-item><text:p text:style-name="Standard">item five</text:p></text:list-item><text:list-item><text:p text:style-name="Standard">item six</text:p></text:list-item></text:list>
 <text:list text:style-name="MultiLevel"><text:list-item><text:p text:style-name="Standard">outline one</text:p><text:list><text:list-item><text:p text:style-name="Standard">outline one one</text:p></text:list-item><text:list-item><text:p text:style-name="Standard">outline one two</text:p><text:list><text:list-item><text:p text:style-name="Standard">outline letter a</text:p></text:list-item><text:list-item><text:p text:style-name="Standard">outline letter b</text:p></text:list-item></text:list></text:list-item></text:list></text:list-item><text:list-item><text:p text:style-name="Standard">outline two</text:p></text:list-item></text:list>
 <text:list text:style-name="Roman"><text:list-item><text:p text:style-name="Standard">roman one</text:p></text:list-item><text:list-item><text:p text:style-name="Standard">roman two</text:p></text:list-item><text:list-item><text:p text:style-name="Standard">roman three</text:p></text:list-item><text:list-item><text:p text:style-name="Standard">roman four</text:p></text:list-item></text:list>
 <text:list text:style-name="Dash"><text:list-item><text:p text:style-name="Standard">dash item</text:p></text:list-item></text:list>
 <text:list text:style-name="WingBullet"><text:list-item><text:p text:style-name="Standard">square item</text:p></text:list-item></text:list>
 <table:table table:name="T1" table:style-name="Tbl"><table:table-column table:style-name="Tbl.A"/><table:table-column table:style-name="Tbl.B"/>
  <table:table-header-rows><table:table-row><table:table-cell table:style-name="CHead"><text:p text:style-name="PCenter">Date</text:p></table:table-cell><table:table-cell table:style-name="CHead"><text:p text:style-name="PCenter">Amount</text:p></table:table-cell></table:table-row></table:table-header-rows>
  <table:table-row><table:table-cell table:style-name="CBody"><text:p text:style-name="Standard">1.1.2026</text:p></table:table-cell><table:table-cell table:style-name="CBody"><text:p text:style-name="PRight">1,000.00</text:p></table:table-cell></table:table-row>
  <table:table-row><table:table-cell table:style-name="CBody"><text:p text:style-name="Standard">2.2.2026</text:p></table:table-cell><table:table-cell table:style-name="CThick"><text:p text:style-name="PRight">250.50</text:p></table:table-cell></table:table-row>
 </table:table>
 <table:table table:name="Layout"><table:table-column table:number-columns-repeated="2"/>
  <table:table-row><table:table-cell><text:p text:style-name="Standard">layout left</text:p></table:table-cell><table:table-cell><text:p text:style-name="Standard">layout right</text:p></table:table-cell></table:table-row>
 </table:table>
 <text:p text:style-name="Standard">Picture: <draw:frame draw:name="pic" text:anchor-type="as-char" svg:width="0.5in" svg:height="0.25in"><draw:image><office:binary-data>iVBORw0KGgoAAAANSUhEUgAAACgAAAAUCAIAAABwJOjsAAAAJElEQVR4nGM4ISc3IIhh1OJRi0ctHrV41OJRi0ctHrV45FgMAFLhLK5mrmiuAAAAAElFTkSuQmCC</office:binary-data></draw:image></draw:frame> inline.</text:p>
 <text:p text:style-name="PIndent">Indented paragraph with spacing and one and a half line height.</text:p>
 <text:p text:style-name="PHanging">Hanging:<text:tab/>indent</text:p>
 <text:p text:style-name="PTabs"><text:tab/>left<text:tab/>centre<text:tab/>right<text:tab/>12.50</text:p>
 <text:p text:style-name="Standard"><text:span text:style-name="TWing">(*</text:span> symbols</text:p>
 <text:p text:style-name="PBreak">After the page break.</text:p>
</office:text></office:body></office:document>