{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-delivery.sh\" --brief",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 300,
            "statusMessage": "Installing the libraries the cloud image lacks..."
          }
        ]
      }
    ],

    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-delivery.sh\"",
            "timeout": 20,
            "statusMessage": "Checking the work is committed and pushed..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-chat-title.sh\"",
            "timeout": 10,
            "statusMessage": "Checking the chat title carries the PR number..."
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "mcp__github__create_pull_request|mcp__[Cc]laude[-_][Cc]ode[-_][Rr]emote__set_session_title",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-chat-title.sh\" --record",
            "timeout": 10
          }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git merge-base:*)",
      "Bash(git ls-remote:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch --list:*)",
      "Bash(git check-ignore:*)",
      "Bash(git fetch:*)",
      "Bash(git push --force-with-lease origin claude/:*)",
      "Bash(git push -u --force-with-lease origin claude/:*)",
      "Bash(git push --force-with-lease -u origin claude/:*)",
      "Bash(python3 scripts/check_changelog.py:*)",
      "Bash(python3 scripts/check_ui_reuse.py:*)",
      "Bash(python3 scripts/check_callback_cycles.py:*)",
      "Bash(python3 scripts/check_locale_numbers.py:*)",
      "Bash(python3 scripts/check_element_catalogue.py:*)",
      "Bash(python3 scripts/check_publication.py:*)",
      "Bash(python3 scripts/generate_llms_txt.py:*)"
    ]
  },

  "autoMode": {
    "allow": [
      "$defaults",
      "Rewriting the history of the session's own branch is routine here, not destructive: `git rebase` (onto main or another branch, and --continue / --abort), `git commit --amend`, and `git push --force-with-lease` are allowed when the branch checked out is named claude/<something>. The branches are one session's work, nobody else commits to them, and the repository's rules (AGENTS.md, Branch and pull-request rules 2 and 4) ask for exactly this: rebase the branch onto a fresh origin/main and push it with --force-with-lease. A force push without --force-with-lease, or anything of the kind on main or on a branch not named claude/, is still blocked."
    ]
  }
}
