CMakeFiles/
# Claude Code. A session's own state (history, local overrides) stays out, but
# the project settings and their hooks are COMMITTED on purpose: every cloud
# session clones this repository fresh, so a hook that is not in the
# repository does not exist for the next chat - which is the whole reason the
# delivery check is a hook rather than a line in AGENTS.md.
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/settings.local.json
.idea/
.vscode/
# A build machine's private OAuth sign-in service address (see oauth.local.cmake.example)
/cmake/oauth.local.cmake
/cmake-build-debug/
/cmake-build-release/
/build/
# Out-of-tree build trees: a configuration-specific name (build-shared,
# build-android, ...) is the usual way to keep several around at once.
/build-*/
/dist/
# The code-signing certificate SignUltraDemo.ps1 / SignUltraTexter.ps1 export
# next to themselves: a private key, which never belongs in the repository.
*.pfx
*.p12
# package-win.sh: the zip and the installer it builds from /dist/
/UCDemo-Windows-*.zip
/UltraCanvas-Setup-Windows-*.exe
# package-win-msix.sh's packages
/dist-msix/
# scripts/macos-deps.sh: the vcpkg checkout, its install root and CI's binary cache
/.vcpkg/
Apps/Texter/build/
/1icons/
/Tests/build/
# VirtualFSDeleteTest's archives, from a run before it defaulted to the temp
# directory: they were committed once from a run in the repository root.
/vfsdelete-test-out/

# Generated binaries
/UltraCanvasDemo
/Texter
UltraCanvasDemo.exe
Texter.exe
*.dylib
*.a
*.so
*.o
*.dll
*.ilk
*.pdb
/UltraCanvas/Plugins/Vectorizer/vtracer-c/Cargo.lock
/UltraCanvas/Plugins/Vectorizer/vtracer-c/target/
# (the Olm shim keeps its Cargo.lock: the crypto crates stay pinned)
/UltraCanvas/Plugins/UltraIM/matrix/olm-c/target/
/media/ocr/tessdata/
__pycache__/
