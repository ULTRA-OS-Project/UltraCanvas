    },
    "adminnote": {
      "x": 4560,
      "y": 4100,
      "w": 420,
      "text": "Admin pages follow Docs/UltraStoreAdmin/README.md: the sidebar lists the store pages then every app and component; the app form carries every catalog setting; Publish checks, signs and uploads; Sales is the ledger sale sync fills; Finance is the affiliate report plus revenue by app. Every figure (revenue, orders, payouts) is sample data for layout only.",
      "fill": "orange"
    },
    "super": {
      "x": 0,
      "y": 8900,
      "text": "UltraStore operator - super admin (proposal)",
      "kind": "title1",
      "maxW": 4480
    },
    "super2": {
      "x": 0,
      "y": 11300,
      "text": "UltraStore operator - review, reports, terms",
      "kind": "title1",
      "maxW": 4480
    },
    "supernote": {
      "x": 4560,
      "y": 9200,
      "w": 420,
      "text": "The operator tier is not in Docs/UltraStore*/README.md yet: it is a proposal for a marketplace where other publishers (merchants) run shops in UltraStore. The operator approves and releases app submissions, handles reports from users and merchants, warns, suspends and reinstates merchants and apps, and keeps every merchant on the current terms of service. Dark sidebar marks the tier. All names, counts and cases are sample data.",
      "fill": "purple"
    }
